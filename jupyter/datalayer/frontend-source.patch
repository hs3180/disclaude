+/** Verify a response still belongs to this live cell before client recovery. */
+export function canApplyServerSnapshot(cell: CodeCell, payload: Record<string, unknown>): boolean {
+  if (cell.isDisposed || !payload || typeof payload.source !== 'string' || payload.outputs_truncated === true) {
+    return false;
+  }
+  const shared = cell.model.sharedModel;
+  if (payload.cell_id !== shared.getId() || payload.source !== shared.getSource() ||
+      payload.source_matches === false || payload.output_attachment === 'historical') {
+    return false;
+  }
+  const active = getServerExecutionMetadata(cell);
+  const provenance = cell.model.getMetadata('jupyter_server_nbmodel_provenance') as Record<string, unknown> | undefined;
+  const target = active?.requestId ?? provenance?.requestId;
+  if (target && target !== payload.request_id) {
+    return payload.request_status === 'queued' && !active;
+  }
+  if (provenance?.requestId === payload.request_id && provenance?.kernelIncarnation &&
+      provenance.kernelIncarnation !== payload.kernel_incarnation) {
+    return false;
+  }
+  if (provenance?.requestId === payload.request_id) {
+    if (provenance.displayUpdatedByRequestId && provenance.displayUpdatedByRequestId !== payload.request_id) {
+      return false;
+    }
+    if (typeof provenance.outputVersion === 'number' && typeof payload.output_version === 'number' &&
+        provenance.outputVersion > payload.output_version) {
+      return false;
+    }
+  }
+  return true;
+}
