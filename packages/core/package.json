{
  "name": "@disclaude/core",
  "version": "0.0.1",
  "description": "Shared core utilities, types, and interfaces for disclaude",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./jupyter": {
      "import": "./dist/jupyter/index.js",
      "types": "./dist/jupyter/index.d.ts"
    },
    "./config-discovery": {
      "import": "./dist/config/discovery.js",
      "types": "./dist/config/discovery.d.ts"
    },
    "./browser-runtime": {
      "import": "./dist/utils/browser-env.js",
      "types": "./dist/utils/browser-env.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "^0.93.0",
    "@jupyter/ydoc": "4.1.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ajv": "8.20.0",
    "cron": "^3.1.6",
    "js-yaml": "^4.1.0",
    "lib0": "0.2.119",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "4.0.0",
    "tough-cookie": "6.0.2",
    "uuid": "^11.1.0",
    "ws": "8.21.3",
    "y-protocols": "1.0.7",
    "yjs": "13.6.27",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.21",
    "@types/pino": "^7.0.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "8.18.2",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1"
  }
}
